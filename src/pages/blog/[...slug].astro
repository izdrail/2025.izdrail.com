---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/nav.astro";
import Footer from "../../components/footer.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <Nav />
  <main class="min-h-screen pt-24 md:pt-28 pb-24 px-4">
    <article class="max-w-3xl mx-auto">
      <time
        class="text-sm text-[var(--sec)]"
        datetime={post.data.pubDate.toISOString()}
      >
        {
          post.data.pubDate.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })
        }
      </time>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold text-[var(--white)]">
        {post.data.title}
      </h1>
      <div
        class="prose mt-8 max-w-none text-[var(--white-icon)] [&_h2]:text-[var(--white)] [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-[var(--white)] [&_p]:my-4 [&_p]:leading-relaxed [&_a]:text-[var(--sec)] [&_ul]:list-disc [&_ul]:pl-6 [&_li]:my-2 [&_strong]:text-[var(--white)]"
      >
        <Content />
      </div>
      <p class="mt-12">
        <a href="/blog" class="text-[var(--sec)]">&larr; All posts</a>
      </p>
    </article>
  </main>
  <Footer />
</Layout>
