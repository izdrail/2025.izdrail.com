---
const technologies = [
  { id: "astro", label: "Astro" },
  { id: "react", label: "React" },
  { id: "typeScript", label: "TypeScript" },
  { id: "tailwindcss", label: "Tailwind CSS" },
  { id: "nodejs", label: "Node.js" },
  { id: "HTML5", label: "HTML" },
  { id: "CSS3", label: "CSS" },
  { id: "javaScript", label: "JavaScript" },
  { id: "git", label: "Git" },
  { id: "supabase", label: "Supabase" },
  { id: "mysql", label: "MySQL" },
  { id: "bash", label: "Bash" },
  { id: "php", label: "PHP" },
  { id: "python", label: "Python" },
  { id: "golang", label: "Go" },
  { id: "laravel", label: "Laravel" },
];
---

<div class="py-6">
  <div
    class="flex flex-wrap items-center justify-center gap-x-7 gap-y-4 max-w-4xl mx-auto"
  >
    {
      technologies.map((tech) => (
        <div class="flex items-center gap-2 group transition-all duration-300">
          <img
            src={`/svg/${tech.id}.svg`}
            alt={tech.label}
            class="h-6 w-auto object-contain transition-transform group-hover:scale-110 opacity-80"
            width="26"
            height="26"
            loading="lazy"
          />
          <span class="text-sm font-medium text-[var(--white-icon)] group-hover:text-[var(--white)] transition-colors">
            {tech.label}
          </span>
        </div>
      ))
    }
  </div>
</div>
