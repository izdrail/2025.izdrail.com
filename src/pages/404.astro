---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";
---

<Layout
  title="Page not found - izdrail.com"
  description="The page you were looking for does not exist."
>
  <Nav />
  <main id="main-content" tabindex="-1" class="min-h-screen pt-24 md:pt-28 pb-24 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-6xl md:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#a476ff] to-[#6d5cff]">
        404
      </p>
      <h1 class="mt-4 text-2xl md:text-3xl font-semibold text-[var(--white)]">
        Page not found.
      </h1>
      <p class="mt-4 text-lg text-[var(--white-icon)]">
        This page took the day off. The link may be old, or it moved.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-[#7c3aed] to-[#a476ff] text-white font-medium rounded-full hover:opacity-90 transition-opacity shadow-lg shadow-[#7c3aed33]"
        >
          Back to home
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[var(--white-icon-tr)] bg-[var(--card)] text-[var(--white-icon)] hover:text-white hover:bg-[var(--white-icon-tr)] transition-colors"
        >
          Read the blog
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
